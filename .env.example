# ===================================================
# appvibe.web.id — PayCore Checkout Environment
# ===================================================
# Copy this file to .env.local (for local Pages dev).
# Do NOT commit real secrets to the repository.
# ===================================================

# --- PayCore Configuration ---
# Base URL for PayCore API (staging or production)
PAYCORE_BASE_URL=https://pay-staging.appvibe.biz.id

# App identifier registered in PayCore
PAYCORE_APP_ID=appvibe_vault

# HARUS SAMA PERSIS dengan VAULT_APP_KEY_ID di PayCore Worker (payment gateway .staging.vars)
# Contoh PayCore default: pk_staging_vault_01 — bukan pk_staging_appvibe_vault_01 kecuali Anda ubah keduanya
PAYCORE_KEY_ID=pk_staging_vault_01

# App secret for signing requests to PayCore API (keep secret!)
PAYCORE_APP_SECRET=

# Webhook secret for verifying events from PayCore (keep secret!)
PAYCORE_WEBHOOK_SECRET=

# Return URL after Duitku payment (user lands here)
PAYCORE_RETURN_URL=https://appvibe.web.id/payment/return

# --- Fulfillment ---
# URL to forward payment fulfillment events (e.g., CRM, email automation)
# Falls back to LEAD_WEBHOOK_URL if not set
FULFILLMENT_WEBHOOK_URL=

# --- Existing (Lead Capture) ---
LEAD_WEBHOOK_URL=
TURNSTILE_SECRET_KEY=

# --- KV Namespace (auto-bound by Cloudflare Pages) ---
# CHECKOUT_EVENTS is bound in Cloudflare Pages dashboard
