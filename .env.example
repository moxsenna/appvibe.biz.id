# ===================================================
# appvibe.biz.id - PayCore Checkout Environment
# ===================================================
# Copy this file to .env.local or .env for local Pages dev.
# Do NOT commit real secrets to the repository.
# This repository is appvibe.biz.id.
# appvibe.web.id is a separate project in D:\Coding\AppVibe v2.
# PayCore is a separate project in D:\Coding\paycore.
# ===================================================

# --- PayCore Configuration ---
# Staging PayCore: https://pay-staging.appvibe.biz.id
# Production PayCore: https://pay.appvibe.biz.id
PAYCORE_BASE_URL=https://pay-staging.appvibe.biz.id

# App identifier registered in PayCore
PAYCORE_APP_ID=appvibe_vault

# Key ID for HMAC signing (provided by PayCore admin)
PAYCORE_KEY_ID=

# App secret for signing requests to PayCore API (keep secret!)
PAYCORE_APP_SECRET=

# Webhook secret for verifying events from PayCore (keep secret!)
PAYCORE_WEBHOOK_SECRET=

# Return URL after payment.
# Current repo has no /payment/return page; use /checkout/ unless one is added.
PAYCORE_RETURN_URL=https://appvibe.biz.id/checkout/

# --- Fulfillment ---
# URL to forward payment fulfillment events (e.g. CRM, email automation)
# Falls back to LEAD_WEBHOOK_URL if not set
FULFILLMENT_WEBHOOK_URL=

# --- Existing Ops / Lead Capture ---
LEAD_WEBHOOK_URL=
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=

# --- Admin ---
ADMIN_TOKEN=

# --- Member Access (WhatsApp Magic Link via Fonnte) ---
# Fonnte API token (https://fonnte.com). Never commit the real value.
FONNTE_TOKEN=

# Canonical public base URL for this repo (used in magic link URLs).
APP_BASE_URL=https://appvibe.biz.id

# Pepper for HMAC-hashing session tokens, magic link tokens, and identity
# hashes. Must be a strong random string (>= 32 chars). Never commit.
AUTH_TOKEN_PEPPER=

# --- KV Namespace ---
# CHECKOUT_EVENTS is bound in Cloudflare Pages dashboard / wrangler config.

# --- D1 Database ---
# APPVIBE_DB is bound in Cloudflare Pages dashboard / wrangler config.
# Create the database:  wrangler d1 create appvibe-member-access
# Run migrations:       wrangler d1 migrations apply appvibe-member-access
# Assign the database_id in wrangler.toml after creation.

# --- AppVibe Flow (Autoresponder) ---
# Event API Worker URL
AVF_EVENT_URL=https://appvibe-flow-api.bimap.workers.dev/v1/events
# Project slug in AppVibe Flow
AVF_PROJECT_SLUG=appvibe-biz-id
# API key for Bearer auth (generated by seed script)
AVF_API_KEY=
# HMAC secret for request signing (generated by seed script)
AVF_HMAC_SECRET=

# --- Access Portal: App Launch & Resource URLs ---
# JSON string containing app launch URLs and bundle resource URLs.
# App URLs are NEVER in the frontend — they are resolved server-side.
# See docs/access-portal-config.md for full structure and instructions.
# Leave URLs empty ("") for resources not yet ready.
ACCESS_RESOURCE_URLS_JSON={"apps":{"adsprint":"","pikat":"","rupa":"","mula":"","arah":"","cetak":"","adegan":"","suara":"","bukti":"","mimik":"","ritme":"","tayang":"","katalog":""},"resources":{"advertiser":{"marketing_kit":"","guide":""},"commerce":{"marketing_kit":"","guide":""},"creator":{"marketing_kit":"","guide":""},"brand_launch":{"marketing_kit":"","guide":""}}}
