# ===================================================
# appvibe.biz.id - PayCore Checkout Environment
# ===================================================
# Copy this file to .env.local or .env for local Pages dev.
# Do NOT commit real secrets to the repository.
# This repository is appvibe.biz.id.
# appvibe.web.id is a separate project in D:\Coding\AppVibe v2.
# PayCore is a separate project in D:\Coding\paycore.
# ===================================================

# --- PayCore Configuration ---
# Staging PayCore: https://pay-staging.appvibe.biz.id
# Production PayCore: https://pay.appvibe.biz.id
PAYCORE_BASE_URL=https://pay-staging.appvibe.biz.id

# App identifier registered in PayCore
PAYCORE_APP_ID=appvibe_vault

# Key ID for HMAC signing (provided by PayCore admin)
PAYCORE_KEY_ID=

# App secret for signing requests to PayCore API (keep secret!)
PAYCORE_APP_SECRET=

# Webhook secret for verifying events from PayCore (keep secret!)
PAYCORE_WEBHOOK_SECRET=

# Return URL after payment.
# Current repo has no /payment/return page; use /checkout/ unless one is added.
PAYCORE_RETURN_URL=https://appvibe.biz.id/checkout/

# --- Fulfillment ---
# URL to forward payment fulfillment events (e.g. CRM, email automation)
# Falls back to LEAD_WEBHOOK_URL if not set
FULFILLMENT_WEBHOOK_URL=

# --- Existing Ops / Lead Capture ---
LEAD_WEBHOOK_URL=
TURNSTILE_SECRET_KEY=

# --- Admin ---
ADMIN_TOKEN=

# --- KV Namespace ---
# CHECKOUT_EVENTS is bound in Cloudflare Pages dashboard / wrangler config.
